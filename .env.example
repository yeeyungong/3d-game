# Vercel: the external WebSocket server, never a secret
PUBLIC_GAME_SERVER_URL=wss://YOUR-SERVER.onrender.com/multiplayer
# Node server: exact frontend origins, comma separated, no trailing slash
ALLOWED_ORIGINS=https://YOUR-PROJECT.vercel.app,http://127.0.0.1:4173
HOST=0.0.0.0
PORT=4173
# Optional Node voice settings; never put TURN_SHARED_SECRET in PUBLIC_* or config.json.
# Comma-separated STUN URLs. Empty disables STUN (same-network QA only).
STUN_URLS=stun:stun.l.google.com:19302
# coturn REST authentication: TURN_URLS and TURN_SHARED_SECRET must both be set.
# TURN_URLS=turn:YOUR-TURN-HOST:3478?transport=udp,turns:YOUR-TURN-HOST:5349?transport=tcp
# TURN_SHARED_SECRET=SET_ON_SERVER_ONLY
